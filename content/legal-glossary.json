{
  "title": "法务实务专业词表",
  "description": "从题库材料中整理的常用法律、合规、交易、争议解决与技术概念，作为题库外的快速查阅资料。",
  "sections": [
    {
      "title": "法律基础类",
      "items": [
        {
          "term": "民法典",
          "definition": "数据权益（第1034-1039条）、格式条款（第496-498条）、虚拟财产（第127条）"
        },
        {
          "term": "个人信息保护法",
          "definition": "告知同意、单独同意、删除权（被遗忘权）、数据出境、自动化决策"
        },
        {
          "term": "数据安全法",
          "definition": "数据分类分级、重要数据、核心数据、数据安全负责人"
        },
        {
          "term": "网络安全法",
          "definition": "关键信息基础设施（CII）、等级保护、安全评估"
        },
        {
          "term": "反不正当竞争法",
          "definition": "虚假宣传、商业诋毁、混淆行为"
        },
        {
          "term": "著作权法",
          "definition": "信息网络传播权、合理使用、避风港原则、红旗原则"
        },
        {
          "term": "未成年人保护法",
          "definition": "网络保护专章、防沉迷、消费限额、实名认证"
        },
        {
          "term": "广告法",
          "definition": "虚假广告、绝对化用语、代言人责任"
        }
      ]
    },
    {
      "title": "数据合规与AI治理类",
      "items": [
        {
          "term": "AIGC",
          "definition": "AI生成内容，涉及版权归属、侵权责任、标识义务"
        },
        {
          "term": "深度合成",
          "definition": "AI换脸、特效滤镜，需安全评估、算法备案、显著标识"
        },
        {
          "term": "算法备案",
          "definition": "具有舆论属性算法需在网信办备案"
        },
        {
          "term": "安全评估",
          "definition": "AI产品上线前需自评或委托评估"
        },
        {
          "term": "数据出境",
          "definition": "标准合同（SCC）、安全评估、个人信息保护影响评估（PIA）"
        },
        {
          "term": "匿名化/去标识化",
          "definition": "处理后无法识别特定个人，匿名化数据不受个保法规制"
        },
        {
          "term": "单独同意",
          "definition": "处理敏感信息、向第三方提供等场景需单独弹窗授权"
        },
        {
          "term": "隐私设计（PbD）",
          "definition": "在产品设计阶段嵌入隐私保护理念"
        },
        {
          "term": "数据本地化",
          "definition": "特定行业数据需存储在境内"
        },
        {
          "term": "GDPR",
          "definition": "欧盟通用数据保护条例，长臂管辖、充分性认定、标准合同"
        },
        {
          "term": "DMA",
          "definition": "欧盟数字市场法案，规制看门人平台"
        },
        {
          "term": "DPDPA",
          "definition": "印度数字个人数据保护法"
        },
        {
          "term": "CCPA/CPRA",
          "definition": "加州消费者隐私法案"
        }
      ]
    },
    {
      "title": "业务合规类",
      "items": [
        {
          "term": "游戏虚拟财产",
          "definition": "账号、装备、道具的权属认定，用户协议设计"
        },
        {
          "term": "防沉迷系统",
          "definition": "实名认证、时长限制、消费限额、人脸识别"
        },
        {
          "term": "外挂打击",
          "definition": "刑法第285条提供侵入计算机信息系统程序罪、刑事报案"
        },
        {
          "term": "UGC侵权",
          "definition": "用户生成内容侵权，通知-删除规则、反通知程序"
        },
        {
          "term": "避风港原则",
          "definition": "平台收到合格通知后及时删除可免责"
        },
        {
          "term": "红旗原则",
          "definition": "侵权事实明显，平台应主动发现处理"
        },
        {
          "term": "直播带货合规",
          "definition": "广告代言人责任、平台连带责任、虚假宣传"
        },
        {
          "term": "SDK合规",
          "definition": "第三方SDK数据收集需单独同意、延迟初始化"
        },
        {
          "term": "车联网数据",
          "definition": "车内处理、匿名化（检出率≥90%）、生物特征书面授权"
        },
        {
          "term": "平行进口",
          "definition": "水货游戏卡带，商标权国际用尽与例外"
        },
        {
          "term": "开源许可证",
          "definition": "GPL（传染性）、MIT（保留版权）、Apache2.0（专利授权）"
        }
      ]
    },
    {
      "title": "投融资与交易类",
      "items": [
        {
          "term": "尽职调查",
          "definition": "审查股权、IP、合同、劳动、合规、诉讼等"
        },
        {
          "term": "SPA/SHA",
          "definition": "股权购买协议/股东协议"
        },
        {
          "term": "VIE架构",
          "definition": "协议控制结构，外资准入合规"
        },
        {
          "term": "反垄断申报",
          "definition": "经营者集中达到标准需事前申报"
        },
        {
          "term": "CFIUS审查",
          "definition": "美国外国投资委员会国家安全审查，关注TID（关键技术/基础设施/敏感数据）"
        },
        {
          "term": "控制权变更条款",
          "definition": "并购触发合同终止权，需提前审查"
        },
        {
          "term": "SLA协议",
          "definition": "服务水平协议，免责条款、赔偿上限"
        },
        {
          "term": "不可抗力",
          "definition": "不能预见、不能避免、不能克服，政策变动是否属于需看合同约定"
        },
        {
          "term": "竞业限制",
          "definition": "补偿金不低于月薪30%、主体适格、配偶持股取证"
        }
      ]
    },
    {
      "title": "诉讼与争议解决类",
      "items": [
        {
          "term": "管辖权异议",
          "definition": "争取主场优势、延缓程序、增加对方成本"
        },
        {
          "term": "示范诉讼",
          "definition": "选取典型案件先行判决，引导类案和解"
        },
        {
          "term": "专家辅助人",
          "definition": "就专业问题出庭解释，辅助法官理解技术"
        },
        {
          "term": "司法鉴定",
          "definition": "代码相似度、算法效果等需有资质机构出具报告"
        },
        {
          "term": "电子证据",
          "definition": "日志、存证、时间戳、区块链存证"
        },
        {
          "term": "律师函",
          "definition": "事实陈述+法律依据+诉求+警告+期限"
        },
        {
          "term": "和解协议",
          "definition": "不起诉承诺、许可范围、免责条款、保密条款"
        },
        {
          "term": "国际仲裁",
          "definition": "一裁终局、纽约公约执行、保密性、费用较高"
        }
      ]
    },
    {
      "title": "监管与舆情类",
      "items": [
        {
          "term": "行政约谈",
          "definition": "监管事前沟通，需快速整改、争取理解"
        },
        {
          "term": "黄金4小时",
          "definition": "舆情爆发后的关键响应窗口，声明需法律审核"
        },
        {
          "term": "12315投诉",
          "definition": "行政调解渠道，需准备正式答复材料"
        },
        {
          "term": "数据泄露应急",
          "definition": "1小时/4小时/30日报告时限、封堵-调查-报告-修复流程"
        },
        {
          "term": "ESG",
          "definition": "环境、社会、公司治理，法务在隐私保护、未成年人保护中发挥作用"
        },
        {
          "term": "科技向善",
          "definition": "A公司使命，产品设计中融入用户保护和社会责任"
        }
      ]
    },
    {
      "title": "技术工具类",
      "items": [
        {
          "term": "合同智能审查",
          "definition": "NLP提取关键字段、风险规则预警"
        },
        {
          "term": "联邦学习",
          "definition": "数据不动模型动，隐私计算技术"
        },
        {
          "term": "差分隐私",
          "definition": "添加噪声保护个体隐私"
        },
        {
          "term": "哈希值",
          "definition": "单向加密，用于通讯录匹配等场景"
        },
        {
          "term": "数字水印",
          "definition": "隐式标识，抗裁剪/压缩"
        },
        {
          "term": "区块链存证",
          "definition": "电子证据固化，防篡改"
        },
        {
          "term": "SCA工具",
          "definition": "开源代码合规扫描，识别许可证风险"
        }
      ]
    }
  ]
}
